# Copy to .env and fill in ONE key: the provider of the model you pass to --model.
#   cp .env.example .env
#
# The key is read from the environment, or from this file by name. It is never printed and never stored
# in a run's output. .env is gitignored.
#
#   --model gemini/gemini-flash-latest          -> GEMINI_API_KEY
#   --model openai/gpt-5.1                      -> OPENAI_API_KEY
#   --model anthropic/claude-sonnet-5            -> ANTHROPIC_API_KEY
#   --model openrouter/qwen/qwen3-235b-a22b      -> OPENROUTER_API_KEY   (reaches most models)
#   --model bedrock/us.anthropic.claude-opus-5   -> no key; signs with your AWS credentials
#   --model hosted_vllm/<name> --api-base http://127.0.0.1:8000/v1  -> no key; a model you serve yourself

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# Any other litellm provider works too: name the variable after the prefix you pass to --model, in
# upper case, with _API_KEY on the end. `--model fireworks_ai/...` reads FIREWORKS_AI_API_KEY.
